// Tuboco — esquema actual de las migraciones 001 a 005.
// Pega este archivo en dbdiagram.io usando el modo DBML.

Enum user_status {
  active
  inactive
}
Enum learning_level {
  beginner
  intermediate
  advanced
}
Enum course_status {
  draft
  published
  archived
}
Enum enrollment_status {
  not_started
  in_progress
  paused
  completed
  abandoned
}
Enum block_type {
  text
  video
  document
  image
  link
  quiz
  practice
  download
}
Enum rule_action {
  add_score
  subtract_score
  exclude_course
  show_warning
  prefer_text_content
}

Table schema_migrations {
  version varchar(100) [pk]
  applied_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Table users {
  id bigint [pk, increment, not null]
  first_name varchar(100) [not null]
  paternal_last_name varchar(100)
  maternal_last_name varchar(100)
  email varchar(255) [not null, unique]
  phone varchar(30)
  password varchar(255) [not null]
  status user_status [not null, default: 'active']
  created_at datetime
  updated_at datetime
}

Table auth_sessions {
  token_hash char(64) [pk, not null]
  user_id bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  expires_at datetime [not null]
  indexes {
    user_id [name: 'idx_auth_sessions_user']
    expires_at [name: 'idx_auth_sessions_expiry']
  }
}

Table regions {
  id bigint [pk, increment, not null]
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  description varchar(500)
  is_active boolean [not null, default: true]
}

Table course_categories {
  id bigint [pk, increment, not null]
  parent_id bigint
  code varchar(50) [not null, unique]
  name varchar(150) [not null]
  description varchar(500)
  is_active boolean [not null, default: true]
}

Table plant_taxa {
  id bigint [pk, increment, not null]
  parent_id bigint
  taxon_type varchar(20) [not null]
  code varchar(80) [not null, unique]
  scientific_name varchar(200) [not null]
  common_name varchar(200)
  ecosystem varchar(100)
  toxicity_level varchar(30)
  pet_safety_warning varchar(500)
  is_active boolean [not null, default: true]
}

Table tag_groups {
  id bigint [pk, increment, not null]
  code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description varchar(500)
}

Table tags {
  id bigint [pk, increment, not null]
  tag_group_id bigint [not null]
  code varchar(80) [not null, unique]
  name varchar(150) [not null]
  description varchar(500)
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
}

Table user_profiles {
  user_id bigint [pk, not null]
  region_id bigint
  knowledge_level learning_level [not null, default: 'beginner']
  has_pets boolean [not null, default: false]
  weak_connection boolean [not null, default: false]
  created_at datetime
  updated_at datetime
  theme varchar(20) [not null, default: 'light']
  font_size varchar(20) [not null, default: 'normal']
  reading_mode boolean [not null, default: false]
  font_mode varchar(20) [not null, default: 'standard']
}

Table user_tags {
  user_id bigint [not null]
  tag_id bigint [not null]
  priority smallint [not null, default: 3]
  created_at datetime
  indexes {
    (user_id, tag_id) [pk]
    (tag_id, user_id)
  }
}

Table user_plants {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  plant_taxon_id bigint [not null]
  context_tag_id bigint
  quantity int
  notes varchar(1000)
  created_at datetime
  indexes {
    (user_id, plant_taxon_id)
  }
}

Table courses {
  id bigint [pk, increment, not null]
  category_id bigint [not null]
  level learning_level [not null, default: 'beginner']
  title varchar(255) [not null]
  slug varchar(280) [not null, unique]
  short_description varchar(500)
  description text
  cover_image_url varchar(1500)
  estimated_minutes int
  status course_status [not null, default: 'draft']
  is_free boolean [not null, default: true]
  created_at datetime
  updated_at datetime
  published_at datetime
}

Table course_tags {
  course_id bigint [not null]
  tag_id bigint [not null]
  weight int [not null, default: 0]
  is_required boolean [not null, default: false]
  indexes {
    (course_id, tag_id) [pk]
    (tag_id, course_id)
  }
}

Table course_plant_taxa {
  course_id bigint [not null]
  plant_taxon_id bigint [not null]
  weight int [not null, default: 0]
  indexes {
    (course_id, plant_taxon_id) [pk]
    (plant_taxon_id, course_id)
  }
}

Table course_regions {
  course_id bigint [not null]
  region_id bigint [not null]
  weight int [not null, default: 0]
  indexes {
    (course_id, region_id) [pk]
    (region_id, course_id)
  }
}

Table course_modules {
  id bigint [pk, increment, not null]
  course_id bigint [not null]
  title varchar(255) [not null]
  description text
  position int [not null]
  estimated_minutes int
  is_required boolean [not null, default: true]
  indexes {
    (course_id, position) [unique]
  }
}

Table lessons {
  id bigint [pk, increment, not null]
  module_id bigint [not null]
  title varchar(255) [not null]
  description text
  position int [not null]
  estimated_minutes int
  is_required boolean [not null, default: true]
  is_preview boolean [not null, default: false]
  indexes {
    (module_id, position) [unique]
  }
}

Table lesson_blocks {
  id bigint [pk, increment, not null]
  lesson_id bigint [not null]
  type block_type [not null]
  title varchar(255)
  body text
  content_data json
  position int [not null]
  is_required boolean [not null, default: true]
  low_bandwidth boolean [not null, default: false]
  indexes {
    (lesson_id, position) [unique]
  }
}

Table course_learning_outcomes {
  id bigint [pk, increment, not null]
  course_id bigint [not null]
  body varchar(1000) [not null]
  position int [not null]
  indexes {
    (course_id, position) [unique]
  }
}

Table course_prerequisites {
  id bigint [pk, increment, not null]
  course_id bigint [not null]
  body varchar(1000) [not null]
  position int [not null]
  indexes {
    (course_id, position) [unique]
  }
}

Table content_references {
  id bigint [pk, increment, not null]
  course_id bigint [not null]
  lesson_id bigint
  title varchar(500) [not null]
  url varchar(1500)
  source_type varchar(30) [not null, default: 'external']
  notes varchar(1500)
  position int [not null, default: 0]
}

Table user_courses {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  course_id bigint [not null]
  status enrollment_status [not null, default: 'not_started']
  progress_percentage decimal(5,2) [not null, default: 0]
  final_score decimal(5,2)
  started_at datetime
  last_accessed_at datetime
  completed_at datetime
  abandoned_at datetime
  abandonment_reason varchar(50)
  created_at datetime
  updated_at datetime
  indexes {
    (user_id, course_id) [unique]
    (user_id, status)
  }
}

Table user_lesson_progress {
  user_course_id bigint [not null]
  lesson_id bigint [not null]
  progress_percentage decimal(5,2) [not null, default: 0]
  is_completed boolean [not null, default: false]
  score decimal(5,2)
  last_block_id bigint
  last_position_seconds int
  started_at datetime
  completed_at datetime
  updated_at datetime
  indexes {
    (user_course_id, lesson_id) [pk]
  }
}

Table user_block_attempts {
  id bigint [pk, increment, not null]
  user_course_id bigint [not null]
  lesson_block_id bigint [not null]
  attempt_number int [not null, default: 1]
  answer_data json
  score decimal(5,2)
  is_passed boolean
  feedback text
  submitted_at datetime
  indexes {
    (user_course_id, lesson_block_id, attempt_number) [unique]
  }
}

Table recommendation_rules {
  id bigint [pk, increment, not null]
  code varchar(120) [unique]
  name varchar(255) [not null]
  priority int [not null, default: 0]
  is_active boolean [not null, default: true]
  description varchar(1000)
  created_at datetime
  updated_at datetime
}

Table recommendation_rule_conditions {
  id bigint [pk, increment, not null]
  rule_id bigint [not null]
  attribute varchar(50) [not null]
  operator varchar(30) [not null]
  value json [not null]
}

Table recommendation_rule_actions {
  id bigint [pk, increment, not null]
  rule_id bigint [not null]
  action rule_action [not null]
  target_tag_id bigint
  score int [not null, default: 0]
  message varchar(1000)
  action_data json
}

Table user_course_recommendations {
  user_id bigint [not null]
  course_id bigint [not null]
  score decimal(10,2) [not null, default: 0]
  reasons json
  is_opened boolean [not null, default: false]
  is_dismissed boolean [not null, default: false]
  generated_at datetime
  indexes {
    (user_id, course_id) [pk]
    (user_id, score)
  }
}

Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: user_profiles.user_id - users.id [delete: cascade]
Ref: user_profiles.region_id > regions.id
Ref: course_categories.parent_id > course_categories.id
Ref: plant_taxa.parent_id > plant_taxa.id
Ref: tags.tag_group_id > tag_groups.id
Ref: user_tags.user_id > users.id [delete: cascade]
Ref: user_tags.tag_id > tags.id
Ref: user_plants.user_id > users.id [delete: cascade]
Ref: user_plants.plant_taxon_id > plant_taxa.id
Ref: user_plants.context_tag_id > tags.id
Ref: courses.category_id > course_categories.id
Ref: course_tags.course_id > courses.id [delete: cascade]
Ref: course_tags.tag_id > tags.id
Ref: course_plant_taxa.course_id > courses.id [delete: cascade]
Ref: course_plant_taxa.plant_taxon_id > plant_taxa.id
Ref: course_regions.course_id > courses.id [delete: cascade]
Ref: course_regions.region_id > regions.id
Ref: course_modules.course_id > courses.id [delete: cascade]
Ref: lessons.module_id > course_modules.id [delete: cascade]
Ref: lesson_blocks.lesson_id > lessons.id [delete: cascade]
Ref: course_learning_outcomes.course_id > courses.id [delete: cascade]
Ref: course_prerequisites.course_id > courses.id [delete: cascade]
Ref: content_references.course_id > courses.id [delete: cascade]
Ref: content_references.lesson_id > lessons.id [delete: cascade]
Ref: user_courses.user_id > users.id [delete: cascade]
Ref: user_courses.course_id > courses.id
Ref: user_lesson_progress.user_course_id > user_courses.id [delete: cascade]
Ref: user_lesson_progress.lesson_id > lessons.id
Ref: user_lesson_progress.last_block_id > lesson_blocks.id
Ref: user_block_attempts.user_course_id > user_courses.id [delete: cascade]
Ref: user_block_attempts.lesson_block_id > lesson_blocks.id
Ref: recommendation_rule_conditions.rule_id > recommendation_rules.id [delete: cascade]
Ref: recommendation_rule_actions.rule_id > recommendation_rules.id [delete: cascade]
Ref: recommendation_rule_actions.target_tag_id > tags.id
Ref: user_course_recommendations.user_id > users.id [delete: cascade]
Ref: user_course_recommendations.course_id > courses.id
